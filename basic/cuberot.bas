10 REM CubeRot - Flipper BASIC
20 REM Cubo 3D proyeccion perspectiva
30 LET R = 0
100 CLS
110 LET C = COS(R)
120 LET S = SIN(R)
130 FOR X = -30 TO 30 STEP 10
140 FOR Y = -30 TO 30 STEP 10
150 FOR Z = -30 TO 30 STEP 10
160 LET D = Z * C - Y * S
170 LET E = Y * C + Z * S
180 LET F = X * C - D * S
190 LET W = X * S + D * C + 100
200 IF W <= 0 THEN GOTO 260
210 LET A = INT(40 * (F * C + E * S) / W + 64)
220 LET B = INT(30 * (E * C - F * S) / W + 32)
230 IF A < 0 THEN GOTO 260
240 IF A > 127 THEN GOTO 260
250 IF B < 0 THEN GOTO 260
255 IF B > 63 THEN GOTO 260
256 PLOT A, B
260 NEXT Z
270 NEXT Y
280 NEXT X
290 LET R = R + 0.01745
300 IF R >= 6.28318 THEN LET R = R - 6.28318
310 PAUSE 30
320 GOTO 100

8  NEXT z, y, x
9  WAIT &H3DA, 8
10 LINE (99, 39)-(221, 161), 0, BF
11 IF LEN(INKEY$) = 0 THEN GOTO 1

